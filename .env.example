
# Required to update order tracking through the admin API
MONGODB_URI=mongodb://127.0.0.1:27017/shine-jewelry
API_PORT=5001
# Frontend build setting (set in Vercel, not needed by the Render API).
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# Render API setting: exact frontend origins, comma-separated, without paths.
# Include both production and preview domains only if previews need API access.
FRONTEND_URL=http://localhost:5173
ADMIN_API_KEY=replace-with-a-long-random-secret
DELIVERY_TOKEN_SECRET=replace-with-another-long-random-secret
SELLER_TOKEN_SECRET=replace-with-a-third-long-random-secret
